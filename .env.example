# Kopiere diese Datei nach .env und fülle die Werte aus.
# Die .env-Datei NIEMALS in die Versionsverwaltung einchecken!

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Pflichtfeld — wird für Embeddings und generative Antworten gebraucht
OPENAI_API_KEY=sk-...

# ── Admin-Konten ──────────────────────────────────────────────────────────────
# Mindestens Konto 1 muss ausgefüllt sein.
# Konten 2 und 3 sind optional (leer lassen = nicht aktiv).
ADMIN_USER_1=admin
ADMIN_PASS_1=sicheres-passwort

ADMIN_USER_2=
ADMIN_PASS_2=

ADMIN_USER_3=
ADMIN_PASS_3=

# ── Weaviate ──────────────────────────────────────────────────────────────────
# Optional — Standard ist http://weaviate:8080 (Docker-internes Netz)
# Nur ändern wenn Weaviate extern läuft:
# WEAVIATE_URL=http://localhost:8080

# ── Datenpfad ─────────────────────────────────────────────────────────────────
# Optional — Verzeichnis für lokale Cache-Dateien (Standard: data/)
# DATA_DIR=data
