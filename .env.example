# OpenAI API-Schlüssel (erforderlich für Embeddings und generative Antworten)
OPENAI_API_KEY=sk-...

# Admin-Passwort für das Streamlit-Frontend (erforderlich)
ADMIN_PASSWORD=dein-sicheres-passwort

# Weaviate-URL (optional — Standard: http://weaviate:8080 im Docker-Netz)
# Für lokales Testen außerhalb von Docker:
# WEAVIATE_URL=http://localhost:8080
WEAVIATE_URL=http://weaviate:8080

# Verzeichnis für lokale Datendateien (optional — Standard: data/)
# DATA_DIR=data
